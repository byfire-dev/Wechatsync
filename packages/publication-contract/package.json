{
  "name": "@wechatsync/publication-contract",
  "version": "0.1.0",
  "description": "Internal legacy Bridge v2 wire contracts for Wechatsync",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "fixtures",
    "README.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./v2": {
      "import": {
        "types": "./dist/v2.d.ts",
        "default": "./dist/v2.js"
      },
      "require": {
        "types": "./dist/v2.d.cts",
        "default": "./dist/v2.cjs"
      }
    },
    "./fixtures/v2/*.json": "./fixtures/v2/*.json"
  },
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:pack": "node scripts/pack-smoke.mjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "tsup": "^8.0.1",
    "typescript": "^5.3.0",
    "vitest": "^1.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
